/* ========================================================================== */
/*                            8. Root Application                             */
/* ========================================================================== */

export default function VoiceNoteDemo(props?: {
  isHovered?: boolean;
  autoPlay?: boolean;
}) {
  const isHovered = props?.isHovered;
  const isCardMode = isHovered !== undefined;
  const [playing, setPlaying] = useState(isCardMode ? false : true);

  useEffect(() => {
    if (isCardMode) {
      setPlaying(Boolean(isHovered));
    }
  }, [isHovered, isCardMode]);

  return (
    <div
      className="flex w-full min-h-[140px] items-center justify-center bg-transparent p-2 font-sans text-neutral-900 dark:text-white"
      style={{
        fontFamily: '"Instrument Sans", "Instrument Sans Fallback", sans-serif',
      }}
    >
      <VoiceNoteGroup>
        <div className="flex w-[350px] max-w-full flex-col items-center justify-center">
          <VoiceNote
            duration={53}
            bars={40}
            seed={7}
            accent="#2563EB"
            size="md"
            playing={playing}
            onPlayingChange={setPlaying}
            defaultPlaying={!isCardMode}
            className="w-full shadow-[0_2px_16px_-4px_rgba(37,99,235,0.2)] dark:shadow-[0_2px_20px_-4px_rgba(37,99,235,0.3)]"
          />
        </div>
      </VoiceNoteGroup>
    </div>
  );
}

