# GEMINI_API_KEY: Server-side key for Gemini OCR and Anna fallback calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Used by City Reader (Gemini Vision REST client).
# Add VITE_GEMINI_API_KEY=<key> to .env.local for local development.
VITE_GEMINI_API_KEY=""

# Kimi K3 / OpenAI-compatible Anna provider (server-side; recommended).
ANNA_API_KEY="YOUR_KIMI_K3_API_KEY"
ANNA_BASE_URL="https://api.apinex.bond/v1"
ANNA_MODEL="free/kimi-k3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ANNA_DEFAULT_KEY: Optional default API key for a custom OpenAI-compatible Anna endpoint.
# Anna uses a zero-key endpoint by default when no custom key is configured.
VITE_ANNA_DEFAULT_KEY="YOUR_DEMO_API_KEY_HERE"
